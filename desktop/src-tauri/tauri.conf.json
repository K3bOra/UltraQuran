{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultra Quran",
  "mainBinaryName": "UltraQuran",
  "version": "1.0.0",
  "identifier": "com.k3bora.ultraquran.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ultra Quran",
    "shortDescription": "ألترا قرآن",
    "longDescription": "القرآن الكريم والمصحف والأذان والموسوعة الإسلامية",
    "copyright": "Ahmed El-Hadary",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
