{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The site (main window, served from k3bora.github.io) and the local adhan card may call the program's own commands.",
  "windows": ["main", "adhan"],
  "local": true,
  "remote": {
    "urls": ["https://k3bora.github.io/*", "https://k3bora.github.io/**"]
  },
  "permissions": [
    "core:default",
    "allow-schedule-prayers",
    "allow-clear-prayers",
    "allow-test-adhan",
    "allow-stop-adhan",
    "allow-open-main",
    "allow-win-minimize",
    "allow-win-hide",
    "allow-win-is-fullscreen",
    "allow-win-toggle-fullscreen",
    "allow-apply-update"
  ]
}
